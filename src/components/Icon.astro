interface Props {
  name: keyof typeof ICONS;
  class?: string;
  size?: number;
  stroke?: number;
}

const { name, class: className = '', size = 18, stroke = 1.8 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICONS[name]}
/>
